# Rust / Cargo
/target/
**/*.rs.bk

# Local Cargo overrides (Phase 7+ fork patch). Only the .example template is
# committed; the real config.toml is per-developer (it may hold an absolute
# local path) and must never be tracked.
/.cargo/config.toml
# Same for the plonky2 crate's own local [patch] wiring (e.g. a local
# plonky2 fork clone).
/plonky2/.cargo/config.toml

# OS cruft
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Misc
*.log

/src/proofs/

# Real datasets: the derived 2^20-key data/{aol,netflix}.keys are committed on purpose
# (see docs/datasets.md); regenerate via scripts/fetch_datasets.py
# /data/*.keys


# …but DO ship the deterministic, non-copyright synthetic datasets so others can
# reproduce byte-for-byte (regenerate via `cargo run --release --example gen_synthetic`).
!/data/gaussian.keys
!/data/uniform.keys
!/data/zipf.keys
!/data/synthetic.manifest.json

# Experiment outputs (regenerate via `cargo run --release --example exp_*`
# then `python3 scripts/plot_experiments.py`)
/results/

/latex/
# Cargo.lock IS committed. The primary deps are already rev-pinned in Cargo.toml,
# but tracking the lock also freezes the crates.io deps (postcard / rand / serde /
# rayon / tracing …) so a fresh clone builds against the exact validated versions.
# (plonky2/Cargo.lock is likewise tracked.)

/paper
/review

# Python bytecode
__pycache__/
*.pyc
/data/*.part
/related_paper

