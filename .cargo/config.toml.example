# Template for `.cargo/config.toml` (which is gitignored).
#
# By default, `Cargo.toml` pulls the four Plonky3-recursion crates from the
# GitHub fork at https://github.com/July620/Plonky3_RangeAir (pinned to a
# specific commit). A fresh `git clone` of this project + `cargo build` works
# without any local fork setup.
#
# This template exists for the *development* workflow: if you want to edit the
# fork's source against this project (live iteration without a push round-trip),
# point Cargo at a local clone of the fork.
#
# To enable the local override on your machine:
#
#   1. git clone https://github.com/July620/Plonky3_RangeAir /path/to/Plonky3_RangeAir
#   2. cp .cargo/config.toml.example .cargo/config.toml
#   3. Replace `/path/to/Plonky3_RangeAir` below with the absolute path to step-1's clone.
#   4. cargo build --release  → now compiles the four crates from your local path.

[patch."https://github.com/July620/Plonky3_RangeAir"]
p3-recursion             = { path = "/path/to/Plonky3_RangeAir/recursion" }
p3-circuit               = { path = "/path/to/Plonky3_RangeAir/circuit" }
p3-circuit-prover        = { path = "/path/to/Plonky3_RangeAir/circuit-prover" }
p3-poseidon2-circuit-air = { path = "/path/to/Plonky3_RangeAir/poseidon2-circuit-air" }
