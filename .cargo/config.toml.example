# Template for the (gitignored) `.cargo/config.toml`.
#
# A fresh `git clone` of this project + `cargo build` works WITHOUT this file:
# `Cargo.toml` already pins the four Plonky3-recursion crates to a specific
# commit of the public fork https://github.com/tuzijun111/Plonky3_RangeAir.
#
# Copy this file to `.cargo/config.toml` only if you want one of the options
# below. `.cargo/config.toml` is gitignored, so any local absolute paths you
# put in it are never committed.
#
#   cp .cargo/config.toml.example .cargo/config.toml

# ---------------------------------------------------------------------------
# Option 1 (recommended for everyone): route cargo's git fetches through the
# system `git` CLI instead of the built-in libgit2 client. libgit2's anonymous
# fetch of the PUBLIC fork intermittently fails with a spurious
# "failed to authenticate" (a transient GitHub 401 / rate-limit that libgit2
# misreports as an auth error). The system git CLI fetches the same public repo
# reliably, so cargo's own error message recommends exactly this setting:
#   https://doc.rust-lang.org/cargo/reference/config.html#netgit-fetch-with-cli
[net]
git-fetch-with-cli = true

# ---------------------------------------------------------------------------
# Option 2 (development only): edit the fork's source against this project (live
# iteration without a push round-trip) by pointing Cargo at a LOCAL clone of the
# fork. Uncomment the block below and set the path.
#
#   1. git clone https://github.com/tuzijun111/Plonky3_RangeAir /path/to/Plonky3_RangeAir
#   2. Replace `/path/to/Plonky3_RangeAir` below with the absolute path to that clone.
#   3. cargo build --release  -> now compiles the four crates from your local path.
#
# Leave this commented out unless you are actively iterating on the fork; an
# override pointing at a non-existent path will make `cargo build` fail.
#[patch."https://github.com/tuzijun111/Plonky3_RangeAir"]
#p3-recursion             = { path = "/path/to/Plonky3_RangeAir/recursion" }
#p3-circuit               = { path = "/path/to/Plonky3_RangeAir/circuit" }
#p3-circuit-prover        = { path = "/path/to/Plonky3_RangeAir/circuit-prover" }
#p3-poseidon2-circuit-air = { path = "/path/to/Plonky3_RangeAir/poseidon2-circuit-air" }

# ---------------------------------------------------------------------------
# Option 3 (zero-knowledge LogUp masks, until Cargo.toml pins the published
# forks): build against local clones of the `zk-logup-mask` branches of the
# Plonky3 core fork (based on Plonky3 56952503) and of tuzijun111/Plonky3_RangeAir
# (based on fbcc78f). Patch EVERY core crate in Cargo.lock: a partial core
# patch duplicates the p3-air / p3-field types (`cargo tree -d` must list no
# p3-* crate). Do not combine with Option 2. A build with this block rewrites
# Cargo.lock to path sources; never commit that Cargo.lock.
#[patch."https://github.com/Plonky3/Plonky3"]
#p3-air              = { path = "/path/to/pl3-core-zkmask/air" }
#p3-baby-bear        = { path = "/path/to/pl3-core-zkmask/baby-bear" }
#p3-batch-stark      = { path = "/path/to/pl3-core-zkmask/batch-stark" }
#p3-challenger       = { path = "/path/to/pl3-core-zkmask/challenger" }
#p3-circle           = { path = "/path/to/pl3-core-zkmask/circle" }
#p3-commit           = { path = "/path/to/pl3-core-zkmask/commit" }
#p3-dft              = { path = "/path/to/pl3-core-zkmask/dft" }
#p3-field            = { path = "/path/to/pl3-core-zkmask/field" }
#p3-fri              = { path = "/path/to/pl3-core-zkmask/fri" }
#p3-goldilocks       = { path = "/path/to/pl3-core-zkmask/goldilocks" }
#p3-keccak           = { path = "/path/to/pl3-core-zkmask/keccak" }
#p3-koala-bear       = { path = "/path/to/pl3-core-zkmask/koala-bear" }
#p3-lookup           = { path = "/path/to/pl3-core-zkmask/lookup" }
#p3-matrix           = { path = "/path/to/pl3-core-zkmask/matrix" }
#p3-maybe-rayon      = { path = "/path/to/pl3-core-zkmask/maybe-rayon" }
#p3-mds              = { path = "/path/to/pl3-core-zkmask/mds" }
#p3-merkle-tree      = { path = "/path/to/pl3-core-zkmask/merkle-tree" }
#p3-monty-31         = { path = "/path/to/pl3-core-zkmask/monty-31" }
#p3-multilinear-util = { path = "/path/to/pl3-core-zkmask/multilinear-util" }
#p3-poseidon1        = { path = "/path/to/pl3-core-zkmask/poseidon1" }
#p3-poseidon1-air    = { path = "/path/to/pl3-core-zkmask/poseidon1-air" }
#p3-poseidon2        = { path = "/path/to/pl3-core-zkmask/poseidon2" }
#p3-poseidon2-air    = { path = "/path/to/pl3-core-zkmask/poseidon2-air" }
#p3-symmetric        = { path = "/path/to/pl3-core-zkmask/symmetric" }
#p3-uni-stark        = { path = "/path/to/pl3-core-zkmask/uni-stark" }
#p3-util             = { path = "/path/to/pl3-core-zkmask/util" }
#
#[patch."https://github.com/tuzijun111/Plonky3_RangeAir"]
#p3-recursion             = { path = "/path/to/pl3-rangeair-zkmask/recursion" }
#p3-circuit               = { path = "/path/to/pl3-rangeair-zkmask/circuit" }
#p3-circuit-prover        = { path = "/path/to/pl3-rangeair-zkmask/circuit-prover" }
#p3-poseidon2-circuit-air = { path = "/path/to/pl3-rangeair-zkmask/poseidon2-circuit-air" }
